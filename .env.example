# ============================================================
#  Halloween iNET 2026 — cấu hình máy chủ (copy thành .env)
#  KHÔNG commit file .env lên git. Mọi secret chỉ nằm ở server.
# ============================================================

NODE_ENV=production
PORT=8080
HOST=127.0.0.1
# Địa chỉ công khai của game (không có / ở cuối) — dùng để kiểm tra Origin cho trang Admin
PUBLIC_URL=https://halloween.inet.vn
# Đặt true khi chạy sau nginx/Cloudflare để lấy đúng IP & nhận diện HTTPS
TRUST_PROXY=true

# ---------- Bí mật (mỗi giá trị >= 32 ký tự ngẫu nhiên) ----------
# Sinh nhanh:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Chia sẻ với đội Portal để ký token đăng nhập (JWT HS256)
PORTAL_JWT_SECRET=
# Chia sẻ với hệ thống billing để ký webhook báo coupon đã dùng
INTEGRATION_SECRET=
# (Tuỳ chọn) khoá mã hoá mã coupon trong DB: 64 ký tự hex. Bỏ trống = dẫn xuất từ APP_SECRET.
# LƯU Ý: đổi khoá sau khi đã phát coupon sẽ không giải mã được mã cũ.
COUPON_ENC_KEY=

# ---------- Tích hợp Portal ----------
# Những trang được phép nhúng game (iframe). Cách nhau bởi dấu phẩy.
PORTAL_ORIGINS=https://portal.inet.vn
# (Tuỳ chọn) yêu cầu token có "aud" bằng giá trị này
PORTAL_JWT_AUDIENCE=
# Thời hạn tối đa cho phép của token Portal (giây). Khuyến nghị Portal ký token 10 phút.
PORTAL_TOKEN_MAX_TTL=86400
# Thời hạn phiên chơi sau khi đăng nhập (giờ)
PLAYER_TOKEN_TTL_H=12

# ---------- API tạo coupon của billing (khi chọn nguồn mã = "API hệ thống billing") ----------
COUPON_API_URL=
COUPON_API_KEY=
COUPON_API_TIMEOUT=8000

# ---------- Quản trị ----------
# Tài khoản quản trị đầu tiên (chỉ dùng khi DB chưa có admin nào). Bỏ trống mật khẩu -> tự sinh vào data/INITIAL_ADMIN_PASSWORD.txt
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_H=12
# (Tuỳ chọn) chỉ cho phép các IP này vào trang Admin. Hỗ trợ tiền tố, vd: 113.161.*
ADMIN_IP_ALLOWLIST=
COOKIE_SECURE=true

# ---------- Chỉ dùng khi phát triển ----------
# Cho phép đăng nhập chơi thử không cần Portal. PHẢI để false ở production.
ALLOW_DEMO_LOGIN=false
# Đăng nhập khách (khi CHƯA tích hợp Portal): mỗi trình duyệt là 1 người chơi. Tắt khi đã có token Portal.
GUEST_LOGIN=true
# Đường dẫn trang quản trị (khó đoán): https://domain/<ADMIN_PATH>/
ADMIN_PATH=dat-duong-dan-kho-doan-o-day
# Thư mục dữ liệu (SQLite + bản sao lưu)
DATA_DIR=data
